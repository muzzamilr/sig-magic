{
  "name": "canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx tsc -b && bunx --bun vite build",
    "lint": "bunx oxlint",
    "preview": "bunx --bun vite preview",
    "typecheck": "bunx tsc -b --noEmit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.0"
  }
}
